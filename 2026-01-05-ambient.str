setCpm(60/4)

$: n("<1 1 3 1 7>*2, <1 2> ~".add(7)
    .add(square.range(0, 2).slow(perlin.range(2, 8))))
  .scale("D:major")
  .s("sine")
  .sometimesBy("0.2", x=>x.gain(0))
  .sometimes(ply(2))
  .lpf(100)
  .lpdecay(1.5)
  .lpq("<2 1 0 -2>/4")
  .lpenv(2)
  .delay("<.5 2>/4")
  .room(.5)
  .sometimes(jux(x=>x.ply(4).gain(.2)))
  .pan(perlin.slow(2))
  .gain(.4)

$: s("didgeridoo(3,8)/2").n(irand(10))
  .attack(.2)
  .lpf(600)
  .gain(.3)
  .speed(sine.range(.3, 1).slow(perlin.range(.3, 8)))
  .vowel("<a e i o u>")
  .delay(.7)
  .delayfb(.8)
  .room(.8)
  .roomsize(5)

$: n("{1 ~ 0 [1 <1 ~>], [8 9 7]/4}".sub(square.range(0, 2).slow(perlin.range(2, 4))))
  .scale("D:major")
  .s("piano")
  .slow(2)
  .sometimesBy(".1", ply("2"))
  .lpf(600)
  .gain(square.range(.3, .3).slow(perlin.range(4, 8)))
  .pan(.6)
  .room(.9)
  .roomsize(4)
